<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="plugin.video.mtvlive"
       name="Magyar TV Live"
       version="1.2.0"
       provider-name="nonoo">
    <requires>
        <import addon="xbmc.python" version="3.0.0" />
        <import addon="inputstream.adaptive" version="2.0.0" optional="true" />
    </requires>
    <extension point="xbmc.python.pluginsource" library="addon.py">
        <provides>video</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">Hungarian public TV live streams (M1, M2, M4 Sport, M5, Duna TV)</summary>
        <description lang="en_GB">Watches M1, M2, M4 Sport, M5 and Duna TV live from Mediaklikk. Resolves stream URLs dynamically at play time — no hardcoded URLs.</description>
        <assets>
            <icon>icon.png</icon>
        </assets>
        <platform>all</platform>
        <license>MIT</license>
    </extension>
</addon>
